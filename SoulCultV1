-- ============================================
-- TREASURE NAME DETECTION
-- ============================================
local TreasurePatterns = {
    Common   = { "common" },
    Rare     = { "rare" },
    VeryRare = { "veryrare", "very rare", "very_rare" },
    Lost     = { "lost" },
}
local TREASURE_PRIORITY = { "VeryRare", "Lost", "Rare", "Common" }

local function GetTreasureTierForName(name)
    local lower = name:lower()
    for _, tierKey in ipairs(TREASURE_PRIORITY) do
        local pats = TreasurePatterns[tierKey]
        if pats then
            for _, p in ipairs(pats) do
                if lower:find(p, 1, true) then return tierKey end
            end
        end
    end
    return nil
end

-- ============================================
-- ALTAR NAME DETECTION
-- ============================================
local ALTAR_KEYWORDS = { "altar" }

local function GetAltarGradeForName(name)
    local lower = name:lower()

    local hasAltar = false
    for _, kw in ipairs(ALTAR_KEYWORDS) do
        if lower:find(kw, 1, true) then
            hasAltar = true
            break
        end
    end
    if not hasAltar then return nil end

    local grade = nil

    local g = lower:match("grade[_%s%-]*([1-5])")
    if g then grade = tonumber(g) end

    if not grade then
        g = lower:match("altar[_%s%-]*([1-5])")
        if g then grade = tonumber(g) end
    end

    if not grade then
        g = lower:match("([1-5])")
        if g then grade = tonumber(g) end
    end

    if grade and grade >= 1 and grade <= 5 then
        return "Grade" .. grade
    end

    return "Grade1"
end

