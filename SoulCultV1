-- ============================================
-- CHARACTER RESPAWN FOR FRESH BODY RELOAD
-- Kills the character immediately, waits for
-- the new body to fully load, then proceeds.
-- ============================================
do
    local _char = LocalPlayer.Character
    local _hum  = _char and _char:FindFirstChildOfClass("Humanoid")
    if _hum and _hum.Health > 0 then
        print("[SoulHub] Respawning for fresh body reload...")
        -- Trigger death via health (works in most games)
        local respawned = false
        local _respawnConn
        _respawnConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            respawned = true
            pcall(function() _respawnConn:Disconnect() end)
        end)
        pcall(function() _hum.Health = 0 end)
        -- Fallback: if health kill doesn't work, try LoadCharacter
        local timeout = tick()
        while not respawned and (tick() - timeout) < 3 do
            task.wait(0.1)
        end
        if not respawned then
            pcall(function() LocalPlayer:LoadCharacter() end)
            timeout = tick()
            while not respawned and (tick() - timeout) < 5 do
                task.wait(0.1)
            end
        end
        -- Wait for the new character to be fully loaded
        local newChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        newChar:WaitForChild("HumanoidRootPart", 10)
        newChar:WaitForChild("Humanoid", 10)
        task.wait(0.5)  -- brief settle so physics is stable
        print("[SoulHub] Fresh body loaded — continuing setup")
    end
end

