-- ============================================
-- S3: SLIDERS icon  (Settings tab)
-- Three horizontal tracks with staggered knobs
-- ============================================
local function BuildSettingsSlidersIcon(parent)
    local bg = BuildIconFrame(parent)
    local C  = Color3.fromRGB(55, 120, 230)
    local W  = 56
    local H  = 46
    local tracks = {
        { y = math.floor(H * 0.28), knobX = math.floor(W * 0.32) },
        { y = math.floor(H * 0.52), knobX = math.floor(W * 0.60) },
        { y = math.floor(H * 0.76), knobX = math.floor(W * 0.44) },
    }
    local lineX0, lineX1 = math.floor(W * 0.13), math.floor(W * 0.87)
    local trackH, knobR  = 2, 4
    for _, t in ipairs(tracks) do
        local track = Create("Frame", {
            Size             = UDim2.new(0, lineX1 - lineX0, 0, trackH),
            Position         = UDim2.new(0, lineX0, 0, t.y - 1),
            BackgroundColor3 = Color3.fromRGB(28, 40, 80),
            BorderSizePixel  = 0, ZIndex = 3, Parent = bg,
        })
        RoundCorner(track, 2)
        local fill = Create("Frame", {
            Size             = UDim2.new(0, t.knobX - lineX0, 0, trackH),
            Position         = UDim2.new(0, lineX0, 0, t.y - 1),
            BackgroundColor3 = C,
            BorderSizePixel  = 0, ZIndex = 4, Parent = bg,
        })
        RoundCorner(fill, 2)
        local knob = Create("Frame", {
            Size             = UDim2.new(0, knobR * 2, 0, knobR * 2),
            Position         = UDim2.new(0, t.knobX - knobR, 0, t.y - knobR),
            BackgroundColor3 = C,
            BorderSizePixel  = 0, ZIndex = 5, Parent = bg,
        })
        RoundCorner(knob, 999)
        local inner = Create("Frame", {
            Size             = UDim2.new(0, knobR, 0, knobR),
            Position         = UDim2.new(0, t.knobX - knobR / 2, 0, t.y - knobR / 2),
            BackgroundColor3 = Color3.fromRGB(160, 200, 255),
            BorderSizePixel  = 0, ZIndex = 6, Parent = bg,
        })
        RoundCorner(inner, 999)
    end
    return bg
end

-- ============================================
-- N4: MESSAGE DOTS icon  (Notifications tab)
-- Uses UDim2 fractions so it fills the icon frame like Sharingan.
-- Bubble: 14% inset all sides, tail bottom-left.
-- ============================================
local function BuildNotifMessageIcon(parent)
    local bg  = BuildIconFrame(parent)
    local C   = Color3.fromRGB(55, 120, 230)
    local BGC = Color3.fromRGB(18, 24, 50)

    -- Bubble body: fills most of the frame, leaves room for tail at bottom
    local bubble = Create("Frame", {
        Size     = UDim2.new(0.80, 0, 0.68, 0),
        Position = UDim2.new(0.10, 0, 0.08, 0),
        BackgroundColor3 = BGC,
        BorderSizePixel  = 0, ZIndex = 3, Parent = bg,
    })
    RoundCorner(bubble, 6)
    Stroke(bubble, C, 1.5)

    -- Three dots centred in bubble using UDim2 fractions
    local dotPositions = { 0.22, 0.50, 0.78 }
    for _, xFrac in ipairs(dotPositions) do
        local dot = Create("Frame", {
            Size     = UDim2.new(0.14, 0, 0.26, 0),
            Position = UDim2.new(xFrac - 0.07, 0, 0.37, 0),
            BackgroundColor3 = C,
            BorderSizePixel  = 0, ZIndex = 4, Parent = bubble,
        })
        RoundCorner(dot, 999)
    end

    -- Tail: small rounded nub bottom-left of bubble
    local tail = Create("Frame", {
        Size     = UDim2.new(0.18, 0, 0.20, 0),
        Position = UDim2.new(0.14, 0, 0.72, 0),
        BackgroundColor3 = BGC,
        BorderSizePixel  = 0, ZIndex = 3, Parent = bg,
    })
    RoundCorner(tail, 3)
    -- Left accent line continuing the bubble stroke onto the tail
    Create("Frame", {
        Size     = UDim2.new(0.025, 0, 0.22, 0),
        Position = UDim2.new(0.14, 0, 0.70, 0),
        BackgroundColor3 = C,
        BorderSizePixel  = 0, ZIndex = 5, Parent = bg,
    })
    return bg
end

