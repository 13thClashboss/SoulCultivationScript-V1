    RoundCorner(MainFrame, 16)
    Stroke(MainFrame, Colors.Border, 5)

    TitleBar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Colors.Darker,
        BorderSizePixel = 0, Parent = MainFrame
    })
    RoundCorner(TitleBar, 16)
    Create("Frame", {
        Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10),
        BackgroundColor3 = Colors.Darker, BorderSizePixel = 0, Parent = TitleBar
    })
    Create("TextLabel", {
        Size = UDim2.new(0, 320, 1, 0), Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1, Text = LocalPlayer.Name .. " - Soul Cultivation",
        TextColor3 = Colors.TextMain, TextSize = 16, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = TitleBar
    })

    local MinBtn = Create("TextButton", {
        Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -38, 0, 7),
        BackgroundColor3 = Color3.fromRGB(28, 36, 65), Text = "X",
        TextColor3 = Color3.fromRGB(140, 200, 255), TextSize = 14,
        Font = Enum.Font.GothamBold, Parent = TitleBar
    })
    RoundCorner(MinBtn, 6)
    MinBtn.MouseButton1Click:Connect(function()
        Settings.UI.Visible = false
        MainFrame.Visible = false
        showNotification("🔴  UI Minimized — Press Right Shift to reopen", 3)
    end)

    local Sidebar = Create("Frame", {
        Size = UDim2.new(0, 70, 1, -45), Position = UDim2.new(0, 0, 0, 45),
        BackgroundColor3 = Color3.fromRGB(12, 15, 28), BorderSizePixel = 0, Parent = MainFrame
    })
    RoundCorner(Sidebar, 16)
    Create("Frame", {
        Size = UDim2.new(0, 70, 0, 20), Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(12, 15, 28), BorderSizePixel = 0, Parent = Sidebar
    })
    Create("Frame", {
        Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -20, 1, -20),
        BackgroundColor3 = Color3.fromRGB(12, 15, 28), BorderSizePixel = 0, Parent = Sidebar
    })

    ContentFrame = Create("Frame", {
        Name = "Content", Size = UDim2.new(1, -70, 1, -45),
        Position = UDim2.new(0, 70, 0, 45), BackgroundTransparency = 1, Parent = MainFrame
    })

    local tabButtons = {}
    local function SetTabVisual(active)
        for tab, btn in pairs(tabButtons) do
            if tab == active then
                btn.BackgroundColor3 = Color3.fromRGB(28, 36, 65)
                btn.TextColor3 = Colors.Accent
            else
                btn.BackgroundColor3 = Color3.fromRGB(22, 28, 50)
                btn.TextColor3 = Colors.TextMuted
            end
        end
    end

    local BTN_W   = 56
    local BTN_H   = 46
    local BTN_X   = (70 - BTN_W) / 2
    local BTN_GAP = 5
    local BTN_START = 5

    -- BuildNotifBellIcon removed — using module-level BuildNotifMessageIcon (N4)

    local tooltip = Create("TextLabel", {
        Size = UDim2.new(0, 80, 0, 26),
        Position = UDim2.new(0, 78, 0, 0),
        BackgroundColor3 = Color3.fromRGB(18, 22, 38),
        BorderSizePixel = 0,
        Text = "",
        TextColor3 = Color3.fromRGB(185, 210, 255),
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        Visible = false,
        ZIndex = 50,
        Parent = MainFrame,
    })
    RoundCorner(tooltip, 6)
    Stroke(tooltip, Colors.Border, 1)

    local function CreateTabButton(text, posY, tabName, isSettings)
        local bh = isSettings and 46 or BTN_H
        local btn = Create("TextButton", {
            Size = UDim2.new(0, BTN_W, 0, bh),
            Position = UDim2.new(0, BTN_X, 0, posY),
            BackgroundColor3 = Color3.fromRGB(22, 28, 50), BorderSizePixel = 0,
            Text = "", TextColor3 = Colors.TextMuted, TextSize = 15,
            Font = Enum.Font.GothamBold, Parent = Sidebar
        })
        RoundCorner(btn, 12)

        if tabName == "Home" then
            BuildImageIcon(btn, ICON_HOME)
        elseif tabName == "ESP" then
            BuildImageIcon(btn, ICON_ESP)
        elseif tabName == "Farming" then
            BuildFittedIcon(btn, ICON_FARMING)
        elseif tabName == "Notifications" then
            BuildNotifMessageIcon(btn)
        elseif tabName == "Settings" then
            BuildSettingsSlidersIcon(btn)
        end

        btn.MouseEnter:Connect(function()
            local btnAbsPos = btn.AbsolutePosition
            local mainAbsPos = MainFrame.AbsolutePosition
            local relY = btnAbsPos.Y - mainAbsPos.Y + (bh / 2) - 13
            tooltip.Text = tabName
            tooltip.Position = UDim2.new(0, 76, 0, relY)
            tooltip.Visible = true
        end)
        btn.MouseLeave:Connect(function()
            tooltip.Visible = false
        end)

        btn.MouseButton1Click:Connect(function()
            Settings.UI.Tab = tabName
            SetTabVisual(tabName)
            RefreshContent()
            tooltip.Visible = false
        end)
        tabButtons[tabName] = btn
    end

    local homeY    = BTN_START + 10
    local espY     = homeY    + BTN_H + 15
    local farmingY = espY     + BTN_H + 15
    local notifY   = farmingY + BTN_H + 15

    CreateTabButton("", homeY,    "Home")
    CreateTabButton("", espY,     "ESP")
    CreateTabButton("", farmingY, "Farming")
    CreateTabButton("", notifY,   "Notifications")

    CreateTabButton("", 0, "Settings", true)
    tabButtons["Settings"].Position = UDim2.new(0, BTN_X, 1, -(BTN_H + 8))

    SetTabVisual(Settings.UI.Tab)

    local TitleDivider = Create("TextButton", {
        Size     = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 45),
        BackgroundColor3 = Colors.Border,
        BorderSizePixel = 0,
        Text = "", AutoButtonColor = false,
        ZIndex = 10, Parent = MainFrame
    })

    local dragStart, startPos
    local function startDrag(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragStart = inp.Position
            startPos  = MainFrame.Position
        end
    end
    TitleBar.InputBegan:Connect(startDrag)
    Sidebar.InputBegan:Connect(startDrag)
    TitleDivider.InputBegan:Connect(startDrag)

    local MIN_W, MIN_H = 300, 200

    -- Subtle resize handle — 3 small dots in the bottom-right corner
    local HANDLE_SIZE = 16
    local resizeHandle = Create("Frame", {
        Size     = UDim2.new(0, HANDLE_SIZE, 0, HANDLE_SIZE),
        Position = UDim2.new(1, -HANDLE_SIZE - 3, 1, -HANDLE_SIZE - 3),
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        ZIndex = 25, Parent = MainFrame,
    })

    -- 3 small grip dots (lower-right diagonal pattern)
    local dotColor = Color3.fromRGB(40, 70, 120)
    for i = 1, 3 do
        local dot = Create("Frame", {
            Size = UDim2.new(0, 2, 0, 2),
            Position = UDim2.new(0, 4 + (i-1)*4, 0, 4 + (i-1)*4),
            BackgroundColor3 = dotColor,
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0,
            ZIndex = 26, Parent = resizeHandle,
        })
        RoundCorner(dot, 2)
    end

    local resizeBtn = Create("TextButton", {
        Size             = UDim2.new(1, 0, 1, 0),
        Position         = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text             = "", BorderSizePixel = 0,
        AutoButtonColor  = false,
        ZIndex           = 27, Parent = resizeHandle,
    })

    local resizing = false
    local resizeStart, startSize2

    resizeBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing    = true
            resizeStart = inp.Position
            startSize2  = MainFrame.Size
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if dragStart then
            local d = inp.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
        if resizing then
            local dx = inp.Position.X - resizeStart.X
            local dy = inp.Position.Y - resizeStart.Y
            MainFrame.Size = UDim2.new(0,
                math.max(MIN_W, startSize2.X.Offset + dx), 0,
                math.max(MIN_H, startSize2.Y.Offset + dy))
            resizeHandle.Position = UDim2.new(1, -HANDLE_SIZE - 3, 1, -HANDLE_SIZE - 3)
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragStart = nil
            resizing  = false
        end
    end)
end

