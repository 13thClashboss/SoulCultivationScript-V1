local ESPPlayers = {}

local function GetPlayerColor(player)
    local team = player.Team
    if team then
        local success, color = pcall(function() return team.Color end)
        if success and color then return color end
    end
    return Color3.fromRGB(60, 140, 230)
end

local function CreatePlayerESP(player)
    if player == LocalPlayer then return end
    if ESPPlayers[player] then return end
    local character = player.Character
    if not character then return end

    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    local attempts = 0
    while (not head or not root) and attempts < 10 do
        task.wait(0.5)
        if not character or not character.Parent then return end
        head = head or character:FindFirstChild("Head")
        root = root or character:FindFirstChild("HumanoidRootPart")
        attempts = attempts + 1
    end
    if not head or not root then
        debugLog("Failed to find head/root for " .. player.Name, true)
        return
    end

    debugLog("Creating player ESP for " .. player.Name)

    local espData = { Player = player, Highlight = nil, NameBillboard = nil }

    local highlight = Instance.new("Highlight")
    highlight.Name = "SoulESP_Highlight"
    highlight.FillColor = GetPlayerColor(player):Lerp(Color3.new(0,0,0), 0.5)
    highlight.OutlineColor = GetPlayerColor(player)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    pcall(function() highlight.OutlineThickness = 2 end)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    espData.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SoulESP_Name"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Parent = head

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name .. " [0m]"
    nameLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextStrokeColor3 = Color3.fromRGB(60, 140, 230)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard
    espData.NameBillboard = billboard
    espData.NameLabel = nameLabel
    espData.Head = head
    espData.Root = root

    ESPPlayers[player] = espData
    debugLog("Player ESP created for " .. player.Name)
end

local function RemovePlayerESP(player)
    local esp = ESPPlayers[player]
    if esp then
        if esp.Highlight then esp.Highlight:Destroy() end
        if esp.NameBillboard then esp.NameBillboard:Destroy() end
        ESPPlayers[player] = nil
        debugLog("Player ESP removed for " .. player.Name)
    end
end

local function UpdatePlayerESP()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    local myPos = localRoot.Position

    for player, esp in pairs(ESPPlayers) do
        if player.Character and player.Character.Parent then
            local root = esp.Root or player.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Parent then
                esp.Root = root
                local dist = (myPos - root.Position).Magnitude
                local show = Settings.ESP.Enabled and dist <= Settings.ESP.Distance

                if esp.Highlight then
                    esp.Highlight.Enabled = show and Settings.ESP.Auras
                end
                if esp.NameBillboard then
                    local showName = show and Settings.ESP.Names
                    esp.NameBillboard.Enabled = showName
                    if showName and esp.NameLabel then
                        esp.NameLabel.Text = player.Name .. " [" .. math.floor(dist) .. "m]"
                    end
                end
            else
                RemovePlayerESP(player)
                task.spawn(function()
                    task.wait(1)
                    if player.Character and player.Character.Parent then
                        CreatePlayerESP(player)
                    end
                end)
            end
        else
            RemovePlayerESP(player)
        end
    end
end

local function OnPlayerAdded(player)
    if player == LocalPlayer then return end
    task.spawn(function()
        if not player.Character then player.CharacterAdded:Wait() end
        task.wait(1)
        if player.Character and player.Character.Parent then
            CreatePlayerESP(player)
        end
    end)
    player.CharacterAdded:Connect(function(character)
        task.spawn(function()
            RemovePlayerESP(player)
            task.wait(1)
            if character and character.Parent then
                CreatePlayerESP(player)
            end
        end)
    end)
end

local function OnPlayerRemoving(player)
    RemovePlayerESP(player)
end

local function InitializeESP()
    task.spawn(function()
        task.wait(5)
        debugLog("Initializing player ESP")
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character.Parent then
                CreatePlayerESP(p)
            end
        end
        debugLog("Starting world object scan")
        ScanWorkspace()
    end)
end

local function StartESPUpdates()
    local ESPTickRate = 0.1
    local lastESPTick = 0
    local conn = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastESPTick < ESPTickRate then return end
        lastESPTick = now
        UpdatePlayerESP()
        UpdateTreasureESP()
        UpdateAltarESP()
    end)
    table.insert(Connections, conn)
    debugLog("ESP update loop started (10Hz throttle)")
end

