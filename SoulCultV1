-- TREASURE ESP SYSTEM
-- ============================================
local TreasureESP = {}

local function CreateTreasureESP(part, tierKey)
    if TreasureESP[part] then return end
    local cfg = GetTreasureTierConfig(tierKey)
    if not cfg then return end

    local data = CreateWorldESP(part, cfg, TreasureHLFolder)
    data.tier = tierKey
    TreasureESP[part] = data

    debugLog("Treasure ESP: " .. part.Name .. " [" .. tierKey .. "]")

    part.AncestryChanged:Connect(function()
        if not part.Parent then
            if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
            if data.Billboard and data.Billboard.Parent then data.Billboard:Destroy() end
            TreasureESP[part] = nil
        end
    end)
end

local function RemoveTreasureESP(part)
    local d = TreasureESP[part]
    if d then
        if d.Highlight and d.Highlight.Parent then d.Highlight:Destroy() end
        if d.Billboard and d.Billboard.Parent then d.Billboard:Destroy() end
        TreasureESP[part] = nil
    end
end

