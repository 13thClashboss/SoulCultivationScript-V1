            TextXAlignment = Enum.TextXAlignment.Left, LetterSpacing = 2, Parent = scroll,
        })
    end

    -- ════════════════════════════════════════════
    -- UI CUSTOMIZATION — compact single card
    -- Left: color wheel (ring)   Right: swatch + opacity + reset
    -- ════════════════════════════════════════════
    SecLabel("🎨  Appearance", y)
    y = y + 20

    -- Card is 108 px tall — tight but breathable
    local CARD_H = 112
    local custCard = Create("Frame", {
        Size = UDim2.new(1, -20, 0, CARD_H),
        Position = UDim2.new(0, 10, 0, y),
        BackgroundColor3 = Colors.Card, BorderSizePixel = 0, Parent = scroll,
    })
    RoundCorner(custCard, 12)
    -- Accent left bar
    local acBar = Create("Frame", {
        Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0, Parent = custCard,
    })
    RoundCorner(acBar, 3)

    -- ── Color wheel ring ──────────────────────────────────────────
    local RING_SZ   = 88          -- outer diameter
    local RING_X    = 14          -- card-relative X of ring top-left
    local RING_Y    = math.floor((CARD_H - RING_SZ) / 2)
    local SEG_N     = 30          -- more segments = smoother
    local OUTER_R   = RING_SZ / 2
    local INNER_R   = OUTER_R * 0.54
    local CX        = RING_X + OUTER_R
    local CY        = RING_Y + OUTER_R
    local PI2       = math.pi * 2
    local ringSegs  = {}

    for i = 0, SEG_N - 1 do
        local midAngle = ((i + 0.5) / SEG_N) * PI2
        local hue      = i / SEG_N
        local midR     = (OUTER_R + INNER_R) / 2
        local segW     = math.ceil(PI2 * OUTER_R / SEG_N) + 2
        local segH     = OUTER_R - INNER_R
        local sx = CX + math.cos(midAngle) * midR - segW / 2
        local sy = CY + math.sin(midAngle) * midR - segH / 2
        local seg = Create("Frame", {
            Size             = UDim2.new(0, segW, 0, segH),
            Position         = UDim2.new(0, sx, 0, sy),
            BackgroundColor3 = Color3.fromHSV(hue, 0.85, 0.95),
            BorderSizePixel  = 0, Rotation = math.deg(midAngle),
            ZIndex = 3, Parent = custCard,
        })
        RoundCorner(seg, 2)
        table.insert(ringSegs, { frame = seg, hue = hue })
    end

    -- Centre hole (card colour)
    Create("Frame", {
        Size             = UDim2.new(0, INNER_R*2, 0, INNER_R*2),
        Position         = UDim2.new(0, CX - INNER_R, 0, CY - INNER_R),
        BackgroundColor3 = Colors.Card,
        BorderSizePixel  = 0, ZIndex = 4, Parent = custCard,
    })

    -- Selector dot
    local selDot = Create("Frame", {
        Size             = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel  = 0, ZIndex = 6, Parent = custCard,
    })
    RoundCorner(selDot, 999)
    Stroke(selDot, Colors.Border, 1.5)

    local function UpdateSelDot(h)
        local angle = h * PI2 - math.pi / 2
        local r = (OUTER_R + INNER_R) / 2
        selDot.Position = UDim2.new(0, CX + math.cos(angle)*r - 5, 0, CY + math.sin(angle)*r - 5)
    end
    UpdateSelDot(UICustom.AccentH / 360)

    -- ── Right panel ───────────────────────────────────────────────
    local RX   = RING_X + RING_SZ + 12   -- right panel X
    local RW   = 680                       -- will be clamped by parent; use big number
    -- (actual width = card width - RX - 10 right pad, but we size by UDim2 offsets from right)

    -- Color swatch (shows current accent, labelled with hue degrees)
    local swatch = Create("Frame", {
        Size             = UDim2.new(1, -(RX + 10), 0, 26),
        Position         = UDim2.new(0, RX, 0, 10),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel  = 0, ZIndex = 3, Parent = custCard,
    })
    RoundCorner(swatch, 7)
    Stroke(swatch, Colors.Border, 1)
    local swLbl = Create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = math.floor(UICustom.AccentH).."°",
        TextColor3 = Color3.fromRGB(255,255,255), TextSize = 11,
