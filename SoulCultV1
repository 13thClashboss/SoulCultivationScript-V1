-- FARMING: KILL AURA
-- ============================================
local FarmingSettings = { KillAura = false }

local KA_DMG_MULTIPLIER = 200
local KA_RANGE          = 6000
local KA_FIRE_INTERVAL  = 4

local _kaPatched = {}
local _castRemote   = nil
local _fireThread   = nil

local function _safePath(root, ...)
    local cur = root
    for _, seg in ipairs({...}) do
        if not cur then return nil end
        cur = cur:FindFirstChild(seg)
    end
    return cur
end

local function _patchValue(obj, newVal)
    for _, p in ipairs(_kaPatched) do
        if p.obj == obj then return end
    end
    local orig = obj.Value
    pcall(function() obj.Value = newVal end)
    table.insert(_kaPatched, { obj = obj, orig = orig })
    debugLog("[KillAura] Patched " .. obj:GetFullName()
        .. "  " .. tostring(orig) .. " → " .. tostring(obj.Value))
end

local function _scanAndPatch(container)
    if not container then return end
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local n = obj.Name:lower():gsub("[%s_%-%.]", "")
            if n:find("damage") or n:find("dmg") or n:find("power")
                or n:find("basedmg") or n:find("atk") or n:find("force") then
                _patchValue(obj, obj.Value * KA_DMG_MULTIPLIER)
            elseif n:find("range") or n:find("radius") or n:find("reach")
                or n:find("aoe") or n:find("distance") then
                if obj.Value < KA_RANGE then
                    _patchValue(obj, KA_RANGE)
                end
            end
        end
        if obj:IsA("BasePart") then
            local n = obj.Name:lower():gsub("[%s_%-%.]", "")
            if n:find("qipressure") or n:find("qip") then
                pcall(function()
                    obj.CanCollide   = false
                    obj.Transparency = 1
                    if obj.CanQuery ~= nil then
                        obj.CanQuery = false
                    end
                end)
            end
        end
    end
end

local function _restoreAll()
    for _, p in ipairs(_kaPatched) do
        pcall(function()
            if p.obj and p.obj.Parent then
                p.obj.Value = p.orig
            end
        end)
    end
    _kaPatched = {}
    debugLog("[KillAura] All values restored")
end

local function _getCastRemote()
    if _castRemote and _castRemote.Parent then return _castRemote end
    local RS = game:GetService("ReplicatedStorage")
    _castRemote = _safePath(RS, "RemoteFunctions", "CastAbility")
    if _castRemote then
        debugLog("[KillAura] CastAbility remote found (hardcoded path)")
        return _castRemote
    end
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteFunction") or obj:IsA("RemoteEvent"))
            and obj.Name:lower():find("castability") then
            _castRemote = obj
            debugLog("[KillAura] CastAbility remote found (broad): " .. obj:GetFullName())
            return _castRemote
        end
    end
    debugLog("[KillAura] CastAbility remote NOT found — skill won't auto-cast", true)
    return nil
end

local function _getQiTool()
    local char = LocalPlayer.Character
    if char then
        local t = char:FindFirstChild("Qi Pressure")
        if t and (t:IsA("Tool") or t:IsA("Model")) then return t end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local t = bp:FindFirstChild("Qi Pressure")
        if t and (t:IsA("Tool") or t:IsA("Model")) then return t end
    end
    return nil
end

local function _fireSkill()
    local remote = _getCastRemote()
    if not remote then return end

    local tool = _getQiTool()

    if remote:IsA("RemoteFunction") then
        task.spawn(function()
            pcall(function()
                if tool then
                    remote:InvokeServer(tool)
                    remote:InvokeServer(tool.Name)
                    remote:InvokeServer("QiPressure")
                    remote:InvokeServer("Qi Pressure")
                else
                    remote:InvokeServer("QiPressure")
                    remote:InvokeServer("Qi Pressure")
                end
            end)
        end)
    elseif remote:IsA("RemoteEvent") then
        task.spawn(function()
            pcall(function()
                if tool then
                    remote:FireServer(tool)
                    remote:FireServer(tool.Name)
                    remote:FireServer("QiPressure")
                else
                    remote:FireServer("QiPressure")
                end
            end)
        end)
    end

    debugLog("[KillAura] Skill fire attempted")
end

local _selfProtectConn = nil

local function _startSelfProtect()
    if _selfProtectConn then _selfProtectConn:Disconnect() end

    local function hookChar(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local tag = char:FindFirstChild("_SoulHubProtect")
        if not tag then
            tag = Instance.new("BoolValue")
            tag.Name = "_SoulHubProtect"
            tag.Value = true
            tag.Parent = char
        end

        _selfProtectConn = hum.HealthChanged:Connect(function(newHealth)
            if not FarmingSettings.KillAura then return end
            if newHealth < hum.MaxHealth * 0.99 then
                pcall(function() hum.Health = hum.MaxHealth end)
            end
        end)
    end

    hookChar(LocalPlayer.Character)
    LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        hookChar(char)
    end)
end

local function _stopSelfProtect()
    if _selfProtectConn then
        _selfProtectConn:Disconnect()
        _selfProtectConn = nil
    end
    local char = LocalPlayer.Character
    if char then
        local tag = char:FindFirstChild("_SoulHubProtect")
        if tag then tag:Destroy() end
    end
end

local function _applyKillAura()
    _kaPatched = {}

    local RS = game:GetService("ReplicatedStorage")
    local rsTemplate = _safePath(RS, "Misc", "QiPressure")
    if rsTemplate then
        _scanAndPatch(rsTemplate)
        debugLog("[KillAura] Patched RS.Misc.QiPressure template")
    else
        debugLog("[KillAura] RS.Misc.QiPressure not found — will patch tool only", true)
    end

    local tool = _getQiTool()
    if tool then
        _scanAndPatch(tool)
        debugLog("[KillAura] Patched tool: " .. tool:GetFullName())
    end

    local dmgCount, rngCount = 0, 0
    for _, p in ipairs(_kaPatched) do
        local n = p.obj.Name:lower()
        if n:find("range") or n:find("radius") or n:find("aoe") or n:find("distance") then
            rngCount = rngCount + 1
        else
            dmgCount = dmgCount + 1
        end
    end
    debugLog("[KillAura] Patches applied — dmg:" .. dmgCount .. "  range:" .. rngCount)

    return dmgCount, rngCount
end

local function StartKillAura()
    FarmingSettings.KillAura = true

    _startSelfProtect()

    local dmgCount, rngCount = _applyKillAura()

    _fireSkill()

    if _fireThread then task.cancel(_fireThread) end
    _fireThread = task.spawn(function()
        while FarmingSettings.KillAura do
            task.wait(KA_FIRE_INTERVAL)
            if not FarmingSettings.KillAura then break end

            local needRepatch = false
            for _, p in ipairs(_kaPatched) do
                if p.obj and p.obj.Parent then
                    local n = p.obj.Name:lower()
                    if (n:find("range") or n:find("radius")) and p.obj.Value < KA_RANGE * 0.5 then
                        needRepatch = true; break
                    elseif p.obj.Value < p.orig * 1.5 then
                        needRepatch = true; break
                    end
                end
            end
            if needRepatch or #_kaPatched == 0 then
                debugLog("[KillAura] Re-patching values (server reset detected)")
                _restoreAll()
                _applyKillAura()
            end

            _fireSkill()
        end
    end)

    if dmgCount + rngCount == 0 then
        showNotification(
            "⚔️  Kill Aura ON\n" ..
            "Activate Qi Pressure manually once.\n" ..
            "Auto re-cast every " .. KA_FIRE_INTERVAL .. "s.", 5)
    else
        showNotification(
            "⚔️  Kill Aura ON  ·  ×" .. KA_DMG_MULTIPLIER ..
            " dmg  ·  " .. KA_RANGE .. " range\n" ..
            "(" .. dmgCount .. " dmg vals  " .. rngCount .. " range vals patched)", 4)
    end
end

local function StopKillAura()
    FarmingSettings.KillAura = false

    if _fireThread then
        task.cancel(_fireThread)
        _fireThread = nil
    end

    _stopSelfProtect()
    _restoreAll()

    showNotification("⚔️  Kill Aura OFF — stats restored", 2)
    debugLog("[KillAura] Stopped")
end

workspace.DescendantAdded:Connect(function(obj)
    if not FarmingSettings.KillAura then return end
    local char = LocalPlayer.Character
