FarmingSettings.AutoBoss = false

local BOSS_KEYWORDS = {
    -- ── CONFIRMED boss names from Soul Cultivation ────────────────────────────
    "hao bing ren", "haobingren",
    "zanshi huo ren", "zanshihuoren",
    "zanshi bing ren", "zanshibingren",
    "respawn hao", "respawn zanshi",
    -- ── Generic fallbacks ─────────────────────────────────────────────────────
    "boss", "demongod", "demon god", "celestialbeing", "celestial being",
    "soulking", "soul king", "ancientbeast", "ancient beast",
    "worldboss", "world boss", "trialboss", "trial boss",
}

local BOSS_ATTACK_RANGE = 8
local LIGHT_ATTACK_INTERVAL = 0.5

local _bossThread    = nil
local _bossBodyPos   = nil
local _bossBodyGyro  = nil

-- ── FIX: persistent no-clip connection ───────────────────────────────────────
local _noClipConn = nil

local function _isBossModel(obj)
    if not obj:IsA("Model") then return false end
    local lower = obj.Name:lower()
    for _, kw in ipairs(BOSS_KEYWORDS) do
        if lower:find(kw, 1, true) then return true end
    end
    return false
end

local function _bossAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local dead = model:FindFirstChild("IsDead") or model:FindFirstChild("Dead")
    if dead and dead:IsA("BoolValue") and dead.Value then return false end
    return true
end

local function _bossRoot(model)
    return model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildOfClass("BasePart")
end

local _cachedBosses   = {}
local _bossRescanTick = 0
local BOSS_RESCAN_INTERVAL = 5

local function _playerCharSet()
    local set = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then set[p.Character] = true end
    end
    return set
end

local function _rebuildBossCache()
    local charSet = _playerCharSet()
    local found = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        local function checkModel(m)
            if not m:IsA("Model") then return end
            if charSet[m] then return end
            if _isBossModel(m) and _bossAlive(m) then
                table.insert(found, m)
            end
        end
        checkModel(obj)
        if obj:IsA("Folder") or obj:IsA("Model") then
            for _, child in ipairs(obj:GetChildren()) do
                checkModel(child)
            end
        end
        if #found >= 2 then break end
    end
    _cachedBosses = found
    _bossRescanTick = tick()
end

local function _findBosses()
    if tick() - _bossRescanTick >= BOSS_RESCAN_INTERVAL then
        _rebuildBossCache()
    end
    local alive = {}
    for _, b in ipairs(_cachedBosses) do
        if _bossAlive(b) then
            table.insert(alive, b)
        end
    end
    -- Sort by distance to player — attack closest boss first
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and #alive > 1 then
        local myPos = hrp.Position
        table.sort(alive, function(a, b)
            local ra = _bossRoot(a)
            local rb = _bossRoot(b)
            local da = ra and (myPos - ra.Position).Magnitude or math.huge
            local db = rb and (myPos - rb.Position).Magnitude or math.huge
            return da < db
        end)
    end
    return alive
end

local FLY_SPEED = 250

-- ── FIXED _enableFlight — continuous no-clip via Heartbeat ───────────────────
local function _enableFlight(hrp)
    -- Clean up any existing movers
    for _, n in ipairs({"_ABossBodyPos","_ABossBodyGyro","_ABossBodyVel","_ABossAngVel"}) do
        local old = hrp:FindFirstChild(n)
        if old then old:Destroy() end
    end

    -- BodyVelocity for steering
    local bv = Instance.new("BodyVelocity")
    bv.Name      = "_ABossBodyVel"
    bv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity  = Vector3.zero
    bv.Parent    = hrp
    _bossBodyPos = bv

    -- BodyAngularVelocity to kill spin
    local bav = Instance.new("BodyAngularVelocity")
    bav.Name           = "_ABossAngVel"
    bav.MaxTorque      = Vector3.new(1e6, 1e6, 1e6)
    bav.AngularVelocity = Vector3.zero
    bav.P              = 3000
    bav.Parent         = hrp

    -- BodyGyro for facing
    local bg = Instance.new("BodyGyro")
    bg.Name      = "_ABossBodyGyro"
    bg.MaxTorque = Vector3.new(0, 1e5, 0)
    bg.D         = 200
    bg.P         = 5000
    bg.CFrame    = hrp.CFrame
    bg.Parent    = hrp
    _bossBodyGyro = bg

    -- Disconnect any existing no-clip loop before making a new one
    if _noClipConn then
        _noClipConn:Disconnect()
        _noClipConn = nil
    end

    -- Continuous no-clip: runs every frame so server/physics can never re-enable collision
    _noClipConn = RunService.Heartbeat:Connect(function()
        if not FarmingSettings.AutoBoss then
            -- Auto-stop if AutoBoss was turned off
            if _noClipConn then
                _noClipConn:Disconnect()
                _noClipConn = nil
            end
            return
        end
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                -- Zero out angular velocity each frame to prevent spin
                pcall(function()
                    p.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
        -- Keep Humanoid from triggering fall/physics animations
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.PlatformStand = true end)
        end
    end)

    debugLog("[AutoBoss] Flight + continuous no-clip enabled (250 studs/s)")
end

-- ── FIXED _disableFlight — kills the no-clip loop then restores collision ─────
local function _disableFlight()
    -- Kill the no-clip heartbeat FIRST so it stops overwriting CanCollide
    if _noClipConn then
        _noClipConn:Disconnect()
        _noClipConn = nil
    end

    -- Zero out velocity so character doesn't drift
    if _bossBodyPos and _bossBodyPos.Parent then
        pcall(function() _bossBodyPos.Velocity = Vector3.zero end)
        _bossBodyPos:Destroy()
    end
    if _bossBodyGyro and _bossBodyGyro.Parent then
        _bossBodyGyro:Destroy()
    end
    _bossBodyPos  = nil
    _bossBodyGyro = nil

    -- Also destroy the anti-spin mover
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bav = hrp:FindFirstChild("_ABossAngVel")
            if bav then bav:Destroy() end
        end
    end

    -- Restore collision and unfreeze humanoid after a short delay so physics can settle
    task.delay(0.5, function()
        local c = LocalPlayer.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    pcall(function() p.CanCollide = true end)
                    pcall(function() p.AssemblyAngularVelocity = Vector3.zero end)
                    pcall(function() p.AssemblyLinearVelocity  = Vector3.zero end)
                end
            end
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.PlatformStand = false end)
            end
        end
    end)

    debugLog("[AutoBoss] Flight disabled, collision restored")
end

-- ── CONFIRMED ATTACK SYSTEM (from dump) ──────────────────────────────────────
-- The boss has Tools named "Light" and "Heavy" in its backpack.
-- Soul Cultivation fires attacks by invoking RemoteEvents under
-- ReplicatedStorage.RemoteEvents — specifically ones related to combat actions.
-- The player's own Light/Heavy tools work the same way.
--
-- Strategy: grab the player's Light tool, equip it if needed, then fire
-- every RemoteEvent in RS.RemoteEvents with the tool + action args.
-- We also try direct tool activation via Tool:Activate().

local _attackRemoteFolder = nil   -- RS.RemoteEvents folder, cached
local _lightTool          = nil   -- player's "Light" tool, cached

local function _getAttackRemoteFolder()
    if _attackRemoteFolder and _attackRemoteFolder.Parent then
        return _attackRemoteFolder
    end
    local RS = game:GetService("ReplicatedStorage")
    _attackRemoteFolder = RS:FindFirstChild("RemoteEvents")
    return _attackRemoteFolder
end

local function _getLightTool()
    -- Check character first (already equipped)
    local char = LocalPlayer.Character
    if char then
        local t = char:FindFirstChild("Light")
        if t and t:IsA("Tool") then return t end
        local h = char:FindFirstChild("Heavy")
        if h and h:IsA("Tool") then return h end
    end
    -- Then backpack
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local t = bp:FindFirstChild("Light")
        if t and t:IsA("Tool") then return t end
        local h = bp:FindFirstChild("Heavy")
        if h and h:IsA("Tool") then return h end
    end
    return nil
end

local function _ensureLightEquipped()
    local char = LocalPlayer.Character
    if not char then return nil end
    -- Already equipped?
    local equipped = char:FindFirstChild("Light")
    if equipped and equipped:IsA("Tool") then return equipped end
    local heavyE = char:FindFirstChild("Heavy")
    if heavyE and heavyE:IsA("Tool") then return heavyE end
    -- Equip from backpack
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        local lt = bp:FindFirstChild("Light")
        if lt and lt:IsA("Tool") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum:EquipTool(lt) end)
                task.wait(0.1)
                return char:FindFirstChild("Light") or lt
            end
        end
        local hv = bp:FindFirstChild("Heavy")
        if hv and hv:IsA("Tool") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum:EquipTool(hv) end)
                task.wait(0.1)
                return char:FindFirstChild("Heavy") or hv
            end
        end
    end
    return nil
end

local function _fireLightAttack()
    local char = LocalPlayer.Character
    if not char then return end

    local RS = game:GetService("ReplicatedStorage")

    -- Ensure Light tool is equipped before attacking
    local tool = _ensureLightEquipped()

    -- Fire RS.RemoteEvents.Attack with multiple arg patterns
    local attackEvent = _safePath(RS, "RemoteEvents", "Attack")
    if attackEvent then
        pcall(function() attackEvent:FireServer() end)
        if tool then
            pcall(function() attackEvent:FireServer(tool) end)
            pcall(function() attackEvent:FireServer(tool.Name) end)
        end
        pcall(function() attackEvent:FireServer("Light") end)
        pcall(function() attackEvent:FireServer("LightAttack") end)
        pcall(function() attackEvent:FireServer(1) end)
    end

    -- Tool:Activate() — works only when actually equipped
    if tool and tool.Parent == char then
        pcall(function() tool:Activate() end)
    end
end

local function _bossLoop()
    debugLog("[AutoBoss] Loop started")

    local RESPAWN_WAIT = 15 * 60
    local deathTimes   = {}
    local attackTick   = 0
    local currentTarget = nil

    _rebuildBossCache()

    while FarmingSettings.AutoBoss do
        task.wait(0.1)

        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not hrp or not hum or hum.Health <= 0 then
            _disableFlight()
            task.wait(3)
            continue
        end

        local bosses = _findBosses()

        if #bosses == 0 then
            if _bossBodyPos and _bossBodyPos.Parent then
                pcall(function() _bossBodyPos.Velocity = Vector3.zero end)
            end
            currentTarget = nil
            local earliest = math.huge
            for _, t in pairs(deathTimes) do
                local rem = RESPAWN_WAIT - (tick() - t)
                if rem > 0 and rem < earliest then earliest = rem end
            end
            if earliest < math.huge then
                local m, s = math.floor(earliest/60), math.floor(earliest%60)
                debugLog(string.format("[AutoBoss] Waiting for respawn — %dm %02ds", m, s))
            end
            continue
        end

        -- Ensure flight + continuous no-clip is active
        if not (_bossBodyPos and _bossBodyPos.Parent) then
            _enableFlight(hrp)
        end

        if not (currentTarget and _bossAlive(currentTarget)) then
            if currentTarget then
                deathTimes[tostring(currentTarget)] = tick()
                debugLog("[AutoBoss] Boss died, switching target")
            end
            currentTarget = bosses[1]
        end

        local targetRoot = _bossRoot(currentTarget)
        if not (targetRoot and targetRoot.Parent) then
            currentTarget = nil
            continue
        end

        local bossPos = targetRoot.Position
        local myPos   = hrp.Position
        local dist    = (myPos - bossPos).Magnitude

        local bv = _bossBodyPos

        if dist > BOSS_ATTACK_RANGE then
            -- ── Phase 1: Fly toward boss ──────────────────────────────────────
            if bv and bv.Parent then
                local dir = (bossPos - myPos).Unit
                bv.Velocity = dir * FLY_SPEED
            end
        else
            -- ── Phase 2: Lock into a stationary hover beside the boss ─────────
            -- Pick a fixed offset position and hold it still — no CFrame snapping
            -- which causes the floating-over and hands-up glitch.
            local hoverOffset = Vector3.new(0, 2, 3)   -- beside+slightly above
            local hoverTarget = bossPos + hoverOffset

            if bv and bv.Parent then
                -- Gently push toward hover position without hard-teleporting
                local toHover = hoverTarget - myPos
                if toHover.Magnitude > 0.8 then
                    bv.Velocity = toHover.Unit * math.min(toHover.Magnitude * 8, 60)
                else
                    bv.Velocity = Vector3.zero
                end
            end

            -- Face the boss (horizontal only)
            if _bossBodyGyro and _bossBodyGyro.Parent then
                local lookDir = Vector3.new(bossPos.X - myPos.X, 0, bossPos.Z - myPos.Z)
                if lookDir.Magnitude > 0.1 then
                    _bossBodyGyro.CFrame = CFrame.new(myPos, myPos + lookDir)
                end
            end

            -- ── Attack every LIGHT_ATTACK_INTERVAL ────────────────────────────
            local now = tick()
            if (now - attackTick) >= LIGHT_ATTACK_INTERVAL then
                attackTick = now
                _fireLightAttack()
            end
        end  -- end if dist > BOSS_ATTACK_RANGE / else

    end  -- end while FarmingSettings.AutoBoss

    _disableFlight()
    debugLog("[AutoBoss] Loop ended")
end

local function StartAutoBoss()
    FarmingSettings.AutoBoss = true
    if _bossThread then task.cancel(_bossThread) end
    _bossThread = task.spawn(_bossLoop)
    showNotification("🐉  Auto Boss ON\nFlying to boss · attacking every 0.5s", 3)
end

local function StopAutoBoss()
    FarmingSettings.AutoBoss = false
    if _bossThread then task.cancel(_bossThread); _bossThread = nil end
    _disableFlight()
    showNotification("🐉  Auto Boss OFF", 2)
end

