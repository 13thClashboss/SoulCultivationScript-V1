-- Parented to PlayerGui for better compatibility with Xeno.

-- ============================================
-- FULL CLEANUP OF PREVIOUS INSTANCE
-- Kills every connection, mover, and GUI from the last run
-- before anything else is created or hooked.
-- ============================================
do
    -- 1. Disconnect all previously stored connections via the global registry
    if _G.__SoulHubConnections then
        for _, c in ipairs(_G.__SoulHubConnections) do
            pcall(function() c:Disconnect() end)
        end
        _G.__SoulHubConnections = nil
        print("[SoulHub] Previous connections disconnected")
    end

    -- 2. Destroy the old GUI (SoulHub + any lingering notifications)
    local _pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if _pg then
        for _, gui in ipairs(_pg:GetChildren()) do
            if gui.Name == "SoulHub" or gui.Name == "SoulNotif" then
                pcall(function() gui:Destroy() end)
            end
        end
    end

    -- 3. Remove any flight/noclip movers left in HumanoidRootPart
    local _char = game:GetService("Players").LocalPlayer.Character
    if _char then
        local _hrp = _char:FindFirstChild("HumanoidRootPart")
        if _hrp then
            for _, name in ipairs({"_ABossBodyVel","_ABossBodyGyro","_ABossAngVel",
                                   "SoulFarmVelocity","SoulFarmGyro"}) do
                local m = _hrp:FindFirstChild(name)
                if m then pcall(function() m:Destroy() end) end
            end
        end
        -- Restore humanoid state
        local _hum = _char:FindFirstChildOfClass("Humanoid")
        if _hum then
            pcall(function() _hum.PlatformStand = false end)
        end
        -- Restore collision on all parts
        for _, p in ipairs(_char:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(function() p.CanCollide = true end)
            end
        end
    end

    -- 4. Clear any _G farming flags so the old boss/kill-aura loops stop
    _G.__SoulHubAutoBoss  = false
    _G.__SoulHubKillAura  = false
    _G.__SoulHubNoClip    = false
end

-- ============================================
-- STORE SOURCE FOR TELEPORT RE-EXECUTE
-- ============================================
do
    local src = nil
    pcall(function() src = getscriptbytecode and getscriptbytecode(script) end)
    if not src then
        pcall(function() src = getscriptsource and getscriptsource(script) end)
    end
    if not src then
        pcall(function()
            for _, s in ipairs(game:GetService("ScriptContext").Scripts) do
                local ok, result = pcall(function() return getscriptbytecode(s) end)
                if ok and result then src = result; break end
            end
        end)
    end
    _G.__SoulHubSource = src
    if src then
        print("[SoulHub] Source stored for re-execute on teleport (" .. #src .. " bytes)")
    else
        print("[SoulHub] Warning: Could not store source — re-execute after rejoin unavailable")
    end
end

