local function CleanupLeftovers()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        -- Remove all known movers by name
        for _, n in ipairs({"SoulFarmVelocity","SoulFarmGyro",
                            "_ABossBodyVel","_ABossBodyGyro","_ABossAngVel"}) do
            local m = root:FindFirstChild(n)
            if m then pcall(function() m:Destroy() end) end
        end
    end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function() humanoid.PlatformStand = false end)
        pcall(function() humanoid.Sit = false end)
    end
    -- Restore collision
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function() p.CanCollide = true end)
        end
    end
end

local function CleanupESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                for _, child in ipairs(head:GetChildren()) do
                    if child:IsA("BillboardGui") and child.Name == "SoulESP_Name" then
                        child:Destroy()
                    end
                end
            end
            for _, child in ipairs(player.Character:GetChildren()) do
                if child:IsA("Highlight") and child.Name == "SoulESP_Highlight" then
                    child:Destroy()
                end
            end
        end
    end
end

