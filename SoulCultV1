-- ============================================
-- SHARED ICON FRAME BUILDER
-- Creates the dot-corner framed background used by all tab icons.
-- ============================================
local ICON_BORDER  = Color3.fromRGB(55, 120, 230)
local ICON_DOT_CLR = Color3.fromRGB(55, 120, 230)
local ICON_BG      = Color3.fromRGB(11, 14, 26)
local ICON_DOT_SZ  = 5
local ICON_CORN_R  = 10

local function BuildIconFrame(parent)
    local bg = Create("Frame", {
        Size             = UDim2.new(1, 0, 1, 0),
        Position         = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = ICON_BG,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = parent,
    })
    RoundCorner(bg, ICON_CORN_R)
    local border = Create("Frame", {
        Size                   = UDim2.new(1, 0, 1, 0),
        Position               = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ZIndex                 = 4,
        Parent                 = parent,
    })
    RoundCorner(border, ICON_CORN_R)
    Stroke(border, ICON_BORDER, 1.5)  -- same border weight as Sharingan
    local half = ICON_DOT_SZ / 2
    local dotPositions = {
        UDim2.new(0, -half, 0, -half),
        UDim2.new(1, -half, 0, -half),
        UDim2.new(0, -half, 1, -half),
        UDim2.new(1, -half, 1, -half),
    }
    for _, pos in ipairs(dotPositions) do
        local dot = Create("Frame", {
            Size             = UDim2.new(0, ICON_DOT_SZ, 0, ICON_DOT_SZ),
            Position         = pos,
            BackgroundColor3 = ICON_DOT_CLR,
            BorderSizePixel  = 0,
            ZIndex           = 5,
            Parent           = parent,
        })
        RoundCorner(dot, 999)
    end
    return bg
end

local function BuildImageIcon(parent, assetId)
    local bg = BuildIconFrame(parent)
    bg.ClipsDescendants = true
    Create("ImageLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
