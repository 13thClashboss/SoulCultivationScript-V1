    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(55, 120, 230)
    stroke.Thickness = 1.5
    stroke.Transparency = 0
    stroke.Parent = notif

    local bar = Instance.new("Frame")
