local function GetTreasureTierConfig(key)
    for _, t in ipairs(TreasureTiers) do
        if t.key == key then return t end
    end
end

local function GetAltarGradeConfig(key)
    for _, g in ipairs(AltarGrades) do
        if g.key == key then return g end
    end
end

local function CreateWorldESP(part, cfg, hlFolder, billboardOffset)
    billboardOffset = billboardOffset or Vector3.new(0, 4, 0)

    local data = {}

    local adornTarget = part
    if part.Parent and part.Parent:IsA("Model") then
        adornTarget = part.Parent
    end

    local hl = Instance.new("Highlight")
    hl.FillColor = cfg.fill
    hl.OutlineColor = cfg.outline
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = adornTarget
    hl.Parent = hlFolder
    data.Highlight = hl

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 240, 0, 42)
    bb.StudsOffset = billboardOffset
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Parent = part

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = cfg.label .. " [0m]"
    lbl.TextColor3 = cfg.textColor
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.TextStrokeTransparency = 0
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bb
    data.Billboard = bb
    data.Label = lbl

    return data
end

