-- ============================================
-- SCANNER
-- ============================================
local function tryRegisterObject(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

    local tierKey = GetTreasureTierForName(obj.Name)
    if tierKey then
        if obj:IsA("BasePart") then
            CreateTreasureESP(obj, tierKey)
        elseif obj:IsA("Model") then
            local root = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
            if root then
                CreateTreasureESP(root, tierKey)
            else
                task.spawn(function()
                    task.wait(0.5)
                    if not obj.Parent then return end
                    local r = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if r then CreateTreasureESP(r, tierKey) end
                end)
            end
        end
        return
    end

    local gradeKey = GetAltarGradeForName(obj.Name)
    if gradeKey then
        if obj:IsA("BasePart") then
            CreateAltarESP(obj, gradeKey)
        elseif obj:IsA("Model") then
            local root = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
            if root then
                CreateAltarESP(root, gradeKey)
            else
                task.spawn(function()
                    task.wait(0.5)
                    if not obj.Parent then return end
                    local r = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if r then CreateAltarESP(r, gradeKey) end
                end)
            end
        end
    end
end

local function ScanWorkspace()
    local descendants = workspace:GetDescendants()
    debugLog("Scanning " .. #descendants .. " workspace descendants for treasure & altars")
    local tFound, aFound = 0, 0

    for _, obj in ipairs(descendants) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            if GetTreasureTierForName(obj.Name) then
                tFound = tFound + 1
                tryRegisterObject(obj)
            elseif GetAltarGradeForName(obj.Name) then
                aFound = aFound + 1
                tryRegisterObject(obj)
            end
        end
    end

    debugLog("Scan complete — Treasure: " .. tFound .. "  Altars: " .. aFound)

    local conn = workspace.DescendantAdded:Connect(function(obj)
        task.wait(0.15)
        tryRegisterObject(obj)
    end)
    table.insert(Connections, conn)
end

-- ============================================
-- UPDATE LOOPS
-- ============================================
local function UpdateTreasureESP()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    local myPos = localRoot.Position

    for part, data in pairs(TreasureESP) do
        if part and part.Parent then
            local tierSettings = Settings.Treasure[data.tier]
            local dist = (myPos - part.Position).Magnitude
            local show = tierSettings and tierSettings.Enabled and dist <= Settings.ESP.Distance

            if data.Highlight then data.Highlight.Enabled = show end
            if data.Billboard then
                data.Billboard.Enabled = show
                if show and data.Label then
                    local cfg = GetTreasureTierConfig(data.tier)
                    data.Label.Text = (cfg and cfg.label or data.tier) .. " [" .. math.floor(dist) .. "m]"
                    if cfg then data.Label.TextColor3 = cfg.textColor end
                end
            end
        else
            RemoveTreasureESP(part)
        end
    end
end

local function UpdateAltarESP()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    local myPos = localRoot.Position

    for part, data in pairs(AltarESP) do
        if part and part.Parent then
            local gradeSettings = Settings.Altar[data.grade]
            local dist = (myPos - part.Position).Magnitude
            local show = gradeSettings and gradeSettings.Enabled and dist <= Settings.ESP.Distance

            if data.Highlight then data.Highlight.Enabled = show end
            if data.Billboard then
                data.Billboard.Enabled = show
                if show and data.Label then
                    local cfg = GetAltarGradeConfig(data.grade)
                    data.Label.Text = (cfg and cfg.label or data.grade) .. " [" .. math.floor(dist) .. "m]"
                    if cfg then data.Label.TextColor3 = cfg.textColor end
                end
            end
        else
            RemoveAltarESP(part)
        end
    end
end

