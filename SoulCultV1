        TextSize = 13, Font = Enum.Font.GothamSemibold, TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sliderFrame
    })
    local distValue = Settings.ESP.Distance
    local distLabel = Create("TextLabel", {
        Size = UDim2.new(0, 70, 0, 20), Position = UDim2.new(1, -80, 0, 8),
        BackgroundTransparency = 1, Text = distValue .. "m", TextColor3 = Colors.Accent,
        TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right,
        Parent = sliderFrame
    })
    local sliderBar = Create("Frame", {
        Size = UDim2.new(1, -32, 0, 8), Position = UDim2.new(0, 16, 0, 38),
        BackgroundColor3 = Colors.SliderBG, BorderSizePixel = 0, Parent = sliderFrame
    })
    RoundCorner(sliderBar, 8)
    local fill = Create("Frame", {
        Size = UDim2.new((distValue-1)/3999, 0, 1, 0), BackgroundColor3 = Colors.SliderFill,
        BorderSizePixel = 0, Parent = sliderBar
    })
    RoundCorner(fill, 8)
    local knob = Create("TextButton", {
        Size = UDim2.new(0, 18, 0, 18), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((distValue-1)/3999, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(50, 130, 220),
        BorderSizePixel = 0, Text = "", AutoButtonColor = false, Parent = sliderBar
    })
    RoundCorner(knob, 999)

    local dragging = false
    local function applySlider(mouseX)
        local barSize = sliderBar.AbsoluteSize.X
        if barSize <= 0 then return end
        local percent = math.clamp((mouseX - sliderBar.AbsolutePosition.X) / barSize, 0, 1)
        distValue = math.max(1, math.floor(1 + percent * 3999))
        Settings.ESP.Distance = distValue
        distLabel.Text = distValue .. "m"
        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, 0, 0.5, 0)
    end

    knob.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    sliderBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; applySlider(inp.Position.X)
        end
    end)
    local sliderEnded = UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    local sliderChanged = UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            applySlider(inp.Position.X)
        end
    end)
    scroll.AncestryChanged:Connect(function()
        if not scroll.Parent then
            sliderEnded:Disconnect()
            sliderChanged:Disconnect()
        end
